#!/usr/bin/env bash
# Run Python in this checkout's environment: `scripts/hermes-python ARGS...`.
#
# A GitHub Actions job runs the interpreter setup-pm exported as A2ASSISTANT_PYTHON,
# so a recipe never re-runs setup on a runner. Anywhere else A2ASSISTANT_PYTHON may
# be inherited from a wrapped `a2assistant` (a release venv without the dev tools),
# so scripts/run-in-hermes-env applies (and if stale, syncs) the environment
# `source ./activate` gives a shell.
set -euo pipefail

if [ "${GITHUB_ACTIONS:-}" = true ] && [ -z "${__HERMES_ACTIVATED:-}" ] && [ -n "${A2ASSISTANT_PYTHON:-}" ] \
    && [ -x "$A2ASSISTANT_PYTHON" ]; then
    exec "$A2ASSISTANT_PYTHON" "$@"
fi
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/run-in-hermes-env" python "$@"
